    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.14.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.5",
    "@vitest/coverage-v8": "^3.0.1",
    "@vitest/ui": "^3.0.1",
    "jsdom": "^27.4.0",
    "typescript": "^5.6.3",
    "vite": "^6.1.5",
    "vitest": "^3.0.1"
  }
}
